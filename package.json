{
  "name": "aiknows-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/verify-build.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "gsc": "node scripts/gsc.mjs",
    "ui:add": "pnpm dlx shadcn@latest add",
    "catalog:build": "tsx scripts/catalog/build.ts",
    "catalog:validate": "tsx scripts/catalog/validate.ts",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "check": "pnpm catalog:build && pnpm test && pnpm typecheck && pnpm format:check",
    "predev": "pnpm catalog:build",
    "prebuild": "pnpm catalog:build",
    "format:check": "prettier --check features scripts/catalog tests .github next.config.ts scripts/dev.mjs scripts/verify-build.mjs",
    "pretest": "pnpm catalog:build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "googleapis": "^173.0.0",
    "prettier": "3.6.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
